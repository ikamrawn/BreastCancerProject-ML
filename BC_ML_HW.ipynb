      "source": [
        "### Step 6: Detailed 2x7 Grid Performance Visualization (Accuracy vs. Recall)\n",
        "As observed, **Recall** is clinically the most vital metric here. Let's build a comprehensive 2x7 layout comparing **Accuracy, Recall, and F1-Score** for each model across both feature sizes."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 538
        },
        "id": "ad8f5994",
        "outputId": "3ba1ae28-f86b-4a7e-85ca-591c5d8387ce"
      },
      "source": [
        "import matplotlib.pyplot as plt\n",
        "import numpy as np\n",
        "\n",
        "# Configure subplot layout\n",
        "fig, axes = plt.subplots(nrows=2, ncols=4, figsize=(16, 8))\n",
        "axes = axes.ravel() # Flatten to 1D array for easier iteration\n",
        "\n",
        "metrics_to_plot = ['Accuracy', 'Recall', 'F1']\n",
        "x_labels = ['10-Feat', '30-Feat']\n",
        "x_indices = np.arange(len(x_labels))\n",
        "width = 0.25\n",
        "\n",
        "# We have 7 models, so we will use the first 7 subplots, leaving the last one for summary text\n",
        "for idx, model_name in enumerate(models_list):\n",
        "    ax = axes[idx]\n",
        "    model_data = df_results[df_results['Model'] == model_name].iloc[0]\n",
        "\n",
        "    # Extract metrics for 10-Feat vs 30-Feat\n",
        "    acc_vals = [model_data['10-Feat Accuracy'], model_data['30-Feat Accuracy']]\n",
        "    rec_vals = [model_data['10-Feat Recall'], model_data['30-Feat Recall']]\n",
        "    f1_vals = [model_data['10-Feat F1'], model_data['30-Feat F1']]\n",
        "\n",
        "    # Plot grouped bars for this specific algorithm\n",
        "    ax.bar(x_indices - width, acc_vals, width, label='Accuracy', color='#4C72B0')\n",
        "    ax.bar(x_indices, rec_vals, width, label='Recall', color='#C44E52') # Highlighted red for Recall\n",
        "    ax.bar(x_indices + width, f1_vals, width, label='F1-Score', color='#55A868')\n",
        "\n",
        "    ax.set_title(model_name, fontsize=12, fontweight='bold')\n",
        "    ax.set_xticks(x_indices)\n",
        "    ax.set_xticklabels(x_labels)\n",
        "    ax.set_ylim(0.70, 1.02) # Focused range\n",
        "    ax.grid(axis='y', linestyle='--', alpha=0.5)\n",
        "    if idx == 0:\n",
        "        ax.legend(loc='lower left')\n",
        "\n",
        "# Use the 8th subplot (index 7) to display clinical selection results highlighting Recall\n",
        "ax_info = axes[7]\n",
        "ax_info.axis('off')\n",
        "\n",
        "# Find best model prioritizing RECALL first, then F1-score\n",
        "best_recall_idx = df_results['30-Feat Recall'].idxmax()\n",
        "best_rec_model = df_results.loc[best_recall_idx]\n",
        "\n",
        "info_text = (\n",
        "    \"CLINICAL SELECTION SUMMARY\\n\\n\"\n",
        "    f\"Because Recall (detecting all malignant cases)\\n\"\n",
        "    f\"is the absolute priority, the top performer is:\\n\\n\"\n",
        "    f\"Model: {best_rec_model['Model']}\\n\"\n",
        "    f\"Using: 30-Feature Configuration\\n\\n\"\n",
        "    f\"• Recall (Sensitivity): {best_rec_model['30-Feat Recall']:.2%}\\n\"\n",
        "    f\"• Accuracy: {best_rec_model['30-Feat Accuracy']:.2%}\\n\"\n",
        "    f\"• F1-Score: {best_rec_model['30-Feat F1']:.2%}\\n\\n\"\n",
        "    f\"This configuration minimizes false negatives\\n\"\n",
        "    f\"better than any other setup.\"\n",
        ")\n",
        "\n",
        "ax_info.text(0.05, 0.5, info_text, transform=ax_info.transAxes,\n",
        "             fontsize=11, va='center', ha='left',\n",
        "             bbox=dict(boxstyle='round,pad=1', facecolor='#FFE6E6', edgecolor='#C44E52'))\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()"
